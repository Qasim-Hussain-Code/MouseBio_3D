{
  "name": "mousebio-3d",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Qasim Hussain",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/third_party_notices.mjs --check && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts",
    "check": "tsc --noEmit",
    "validate:geometry": "python3 scripts/test_geometry.py",
    "resources": "python3 scripts/resource_usage.py",
    "notices": "node scripts/third_party_notices.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
