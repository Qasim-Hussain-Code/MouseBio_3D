    "licenseEvidenceUrl": "https://neuroimage.usc.edu/neuro/Digimouse_license",
    "archiveSha256": "6f7cbd8a7236a78c47a14c3259d387439c0dc0284b2a83fa955f8c49efe11761",
    "attribution": "Digimouse, Belma Dogdas, David Stout, Arion F. Chatziioannou and Richard M. Leahy, USC/UCLA, 2007. Volume surfaces adapted by Qasim Hussain for MouseBio_3D under CC BY-SA 4.0.",
    "methodology": "Registered postmortem CT and colour cryosections from one 28 g normal nude male mouse; categorical anatomical label image.",
    "sourceVoxelSpacingMm": [
      0.1,
      0.1,
      0.1
    ],
    "sourceDimensions": [
      380,
      992,
      208
    ],
    "modifications": [
      "Explicit categorical grid subsampling",
      "Binary half-value interfaces on a consistent tetrahedral grid",
      "Outward triangle winding and area-weighted normals",
      "Indexed glTF surfaces with nonquantitative display colours"
    ]
  },
  "levels": [
    {
      "id": "fine-020",
      "title": "Finer surface (0.2 mm)",
      "processingVoxelSpacingMm": [
        0.2,
        0.2,
        0.2
      ],
      "description": "Every second source sample is retained for the selected region.",
      "limitations": [
        "Subsampling can remove thin features and small components.",
        "Finer processing does not add named structures, tissue layers or cellular anatomy."
      ]
    },
    {
      "id": "source-010",
      "title": "Source-grid surface (0.1 mm)",
      "processingVoxelSpacingMm": [
        0.1,
        0.1,
        0.1
      ],
      "description": "All supplied categorical source samples are retained for the selected gland label.",
      "limitations": [
        "Available only for the source lachrymal and adrenal gland labels to bound storage and rendering cost.",
        "Source-grid sampling adds no anatomy beyond the supplied label image and is not an anatomical accuracy guarantee.",
        "Paired source labels remain shared; no laterality is assigned."
      ]
    }
  ],
